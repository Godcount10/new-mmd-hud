{
  "name": "mmd-new-host-preview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:spine-catalog": "node scripts/generate-spine-catalog.mjs",
    "generate:spine-thumbnails": "node scripts/generate-spine-thumbnails.mjs",
    "prepare:spine-release": "node scripts/prepare-spine-release.mjs",
    "test:spine": "node --test tests/spine-contracts.test.mjs",
    "test:hud-json": "node scripts/verify-hud-json.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "build:hud:bundle": "vite build --mode hud",
    "build:hud:json": "node scripts/build-role-card-json.mjs",
    "build:hud": "npm run typecheck && npm run build:hud:bundle && npm run build:hud:json",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@esotericsoftware/spine-webgl": "^4.0.31",
    "lucide-vue-next": "1.0.0",
    "spine-webgl-41": "npm:@esotericsoftware/spine-webgl@4.1.56",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.8",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "spine-canvas-40": "npm:@esotericsoftware/spine-canvas@4.0.31",
    "spine-canvas-41": "npm:@esotericsoftware/spine-canvas@4.1.56",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^3.3.8"
  }
}
